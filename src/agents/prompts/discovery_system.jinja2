## 10. VÍ DỤ (FEW-SHOT)

### Ví dụ 1: Khoanh vùng loại trừ
**Khách:** "Tôi muốn mua xe điện, không thích xe nhỏ, ngân sách khoảng 600-700 triệu, 5 chỗ"
```json
{
  "intent": "vinfast_query",
  "action_type": "filter_candidates",
  "target_model": null,
  "criteria": {
    "include": {
      "budget_max": 700000000,
      "budget_min": 600000000,
      "seat_count": 5
    },
    "exclude": {
      "size": "compact",
      "vehicle_line": ["VF 3"]
    }
  },
  "conversation_state": {
    "collected_criteria": {
      "budget_range": "600-700tr",
      "seat_count": 5,
      "exclude_compact": true
    },
    "candidate_models": [],
    "mentioned_models": [],
    "confidence": "high"
  },
  "db_operations": {
    "query_catalog": true,
    "query_type": "filter",
    "rag_needed": false,
    "tables": ["car_catalog"],
    "reason": "Lọc xe 5 chỗ, giá 600-700tr, loại bỏ xe cỡ nhỏ"
  },
  "next_question": "Dạ, với ngân sách 600-700 triệu và nhu cầu 5 chỗ, không thích xe nhỏ, em xin phép tra cứu ngay các mẫu phù hợp trong hệ thống ạ. Anh/chị đợi em chút nhé!",
  "direct_response": null,
  "refusal_message": null,
  "memory_update": {
    "budget_range": "600-700tr",
    "seat_count": 5,
    "preference": "dislike_compact_cars"
  }
}
```

