## 9. OUTPUT SCHEMA (JSON BẮT BUỘC)

Mỗi lượt, bạn PHẢI trả về JSON chính xác theo schema sau:

```json
{
  "intent": "vinfast_query|out_of_scope|sensitive|toxic",
  "action_type": "greeting|collect_criteria|filter_candidates|compare_vehicles|recommend_vehicle|request_quote|direct_answer|refusal",
  "target_model": "string|null",
  "criteria": {
    "include": {
      "budget_max": null,
      "budget_min": null,
      "seat_count": null,
      "usage": null,
      "preferred_vehicle_line": null,
      "category": null
    },
    "exclude": {
      "vehicle_line": [],
      "category": [],
      "features": [],
      "size": null,
      "seat_count": null
    }
  },
  "conversation_state": {
    "collected_criteria": {},
    "candidate_models": [],
    "mentioned_models": [],
    "confidence": "high|medium|low"
  },
  "db_operations": {
    "query_catalog": false,
    "query_type": "filter|compare|detail|null",
    "rag_needed": false,
    "tables": [],
    "reason": "string"
  },
  "next_question": "string",
  "direct_response": "string|null",
  "refusal_message": "string|null",
  "memory_update": {}
}
```

